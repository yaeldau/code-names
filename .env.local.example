# Supabase — copy this file to .env.local and fill in values from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin dashboard (/admin) — password-protected internal game inspector.
# ADMIN_SESSION_SECRET signs the login session cookie; generate a long random
# value (e.g. `openssl rand -hex 32`) and never reuse it as the password.
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_SESSION_SECRET=generate-a-long-random-secret

# Set only once the game_events migration (supabase/migrations/20260903112807_atomic_reveal_events.sql)
# is actually deployed — the exact deploy timestamp, e.g. 2026-09-05T12:00:00Z.
# Leave unset until then; the admin dashboard shows "not enabled yet" for its
# event-history section rather than querying a table that doesn't exist.
GAME_EVENTS_ENABLED_AT=

# Feedback form (/api/feedback) — sends visitor messages to your inbox via Resend.
# Get an API key at https://resend.com/api-keys. FEEDBACK_FROM_EMAIL must be on a
# domain you've verified in Resend. FEEDBACK_TO_EMAIL is never exposed to the client.
RESEND_API_KEY=re_your-api-key
FEEDBACK_TO_EMAIL=you@example.com
FEEDBACK_FROM_EMAIL=feedback@your-verified-domain.com
